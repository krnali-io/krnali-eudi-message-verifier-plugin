PUBLIC_BASE_URL=https://verify.example.test
VERIFIER_INTERNAL_URL=http://verify-link-verifier:8080
ISSUER_CHAIN_FILE=/secrets/issuer-chain.pem
REGISTRATION_CERTIFICATE_FILE=/registration/registration.jwt
BUSINESS_NAME=krnali labs
OPERATORS=operator@example.test:supervisor
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=REPLACE_WITH_VERIFY_LINK_APP_AUDIENCE
LINK_TTL=10m
VERIFY_WINDOW=5m
CLAIMS_TTL=10m
RESPONSE_MODE=direct_post
WALLET_SCHEME=haip-vp
# Enable only behind the restricted cloudflared ingress.
TRUST_PROXY=false

# Local development only: PUBLIC_BASE_URL must be localhost.
# OPERATOR_USER=operator@example.test
# OPERATOR_PASSWORD=

# Channels with incomplete configuration are disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
